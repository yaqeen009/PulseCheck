# PulseCheck environment configuration.
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# Every value below is a placeholder or a safe local-development default.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Port the API listens on. The web dev server proxies /api here, so if you
# change this, change API_TARGET in packages/web/vite.config.ts to match.
PORT=4100
# Public origin of the web app. Used for CORS + cookie/CSRF decisions.
# The Vite dev server port is fixed in packages/web/vite.config.ts.
WEB_ORIGIN=http://localhost:5273
# Comma-separated allowlist of extra origins permitted to call the API.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database (Neon / Lakebase Postgres)
# ---------------------------------------------------------------------------
# Application traffic uses the POOLED connection string. `neon env pull` and
# `neon deploy` write this value for the linked branch.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Migrations, pg_dump and anything needing session state use the DIRECT
# (unpooled) connection string. `prisma.config.ts` prefers it when it is set.
DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Unpooled alias written by `neon env pull`; keep it if your tooling reads it.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# Linked branch name, written by `neon env pull`.
NEON_BRANCH=production

# Local development Postgres managed by `npm run db:up` (embedded-postgres).
# Only the test suite uses an embedded server (port 55433, see
# packages/server/vitest.config.ts); set DATABASE_URL to the value printed by
# `npm run db:up` to develop against a local database instead of Neon.
EMBEDDED_PG_PORT=55432
EMBEDDED_PG_DIR=./.pgdata
EMBEDDED_PG_DATABASE=pulsecheck

# ---------------------------------------------------------------------------
# Authentication (Neon Auth / Managed Better Auth)
# ---------------------------------------------------------------------------
# Passwords, email verification and sessions are owned by Neon Auth on the
# linked branch, not by this service. `neon deploy` writes both URLs; there is
# no secret to manage here. Declare `auth: true` in neon.ts.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Same Auth URL, exposed to the browser bundle by Vite (see
# packages/web/vite.config.ts, which reads this file as its envDir).
VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
# Registration policy (open sign-ups, email verification, allowed domains) is a
# Neon Auth branch setting, not an environment variable. Localhost origins are
# allowed by default; add production origins with
# `neon neon-auth domain add https://app.example.com`.

# ---------------------------------------------------------------------------
# Frontend (Vercel build-time variables)
# ---------------------------------------------------------------------------
# Absolute base URL of the deployed API, e.g. https://pulsecheck-api.onrender.com.
# Set this in Vercel only; leave it empty in development so the Vite dev-server
# proxy keeps requests same-origin. Must be https to avoid mixed content.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Monitoring engine
# ---------------------------------------------------------------------------
# Run the scheduler inside this process. In a horizontally scaled deployment run
# exactly one scheduler instance (see docs/ARCHITECTURE.md).
SCHEDULER_ENABLED=true
WORKER_ENABLED=true
# SSRF guard: refuse outbound checks to loopback, private, link-local (including
# cloud metadata at 169.254.169.254), unique-local and other non-routable ranges.
# Keep true. Setting it to false disables the address checks entirely and must
# only ever be done in an isolated test environment (for example to monitor a
# local mock server); it is never required by the test suite, which sets it in
# packages/server/vitest.config.ts.
BLOCK_PRIVATE_NETWORKS=true
# Require https for monitored targets (extra hardening; default off).
REQUIRE_HTTPS_TARGETS=false

# ---------------------------------------------------------------------------
# Limits (optional overrides; see packages/shared/src/limits.ts for defaults)
# ---------------------------------------------------------------------------
# MAX_MONITORS_PER_USER=25
# MIN_INTERVAL_SECONDS=30
# MAX_TIMEOUT_MS=30000
# CHECK_CONCURRENCY=8
# RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MINUTES=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
